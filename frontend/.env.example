# ─────────────────────────────────────────
# Configuración para desarrollo local
# ─────────────────────────────────────────

# Base de datos PostgreSQL (local o Supabase)
# Local:   postgresql://usuario:password@localhost:5432/bd_mundodecantsni
# Supabase: postgresql://postgres:password@db.xxxxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://usuario:password@localhost:5432/bd_mundodecantsni"

# Auth.js (NextAuth) - Generar con: openssl rand -base64 32
AUTH_SECRET="tu-secreto-aqui"

# URL de la aplicación (cambiar en producción)
# Desarrollo: http://localhost:3000
# Producción: https://mundodecants.vercel.app
AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────
# Para migraciones (conexión directa, no pooler)
DIRECT_URL="postgresql://postgres:password@db.xxxxxxxxxxxxxx.supabase.co:5432/postgres"

# Supabase Storage (para imágenes en prod)
# ─────────────────────────────────────────
# Opcional en desarrollo local (usa sistema de archivos)
# Obligatorio en producción (Vercel no tiene sistema de archivos persistente)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJxxxxx..."
SUPABASE_SERVICE_ROLE_KEY="eyJxxxxx..."
SUPABASE_STORAGE_BUCKET="product-images"

# Entorno
NODE_ENV="development"
